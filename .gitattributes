core/data/cards_data.json filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
core/rpgasset/guildwar/ruins/*.png -filter -diff -merge -text
core/rpgasset/guildwar/ruins/props/*.png -filter -diff -merge -text
# the turn-crystal must be real pixels everywhere (reset --hard deploys on
# the boxes would otherwise serve an LFS pointer to the renderer)
core/rpgasset/ui/crystal.png -filter -diff -merge -text
# the runic glyph font must be real bytes everywhere (reset --hard deploys on
# the boxes would otherwise serve an LFS pointer; the renderer's isRealFont
# check would skip it and rune tiles hexbox again)
core/rpgasset/fonts/NotoSansRunic-Regular.ttf -filter -diff -merge -text
# new abyss-native monster sprites must be real pixels everywhere (reset
# --hard deploys on the boxes would otherwise serve an LFS pointer)
core/rpgasset/enemies/abyss/*.png -filter -diff -merge -text
# 2026-10-09 round-8: the CORE bestiary pool (hybrides/mutated/calamaties/
# elemental bosses etc.) is the abyss encounter art — same stub hazard as
# enemies/abyss above, real bytes as plain git blobs
core/rpgasset/enemies/*.png -filter -diff -merge -text
# 2026-10-09 abyss real-asset pass: the background pool must be real pixels
# everywhere (reset --hard deploys on the boxes would otherwise serve an LFS
# pointer to the renderer — same rule as enemies/abyss above)
core/rpgasset/environment/abyss/*.png -filter -diff -merge -text
# runtime-fetched Digimon cache must survive `git reset --hard` deploys as
# real pixels (the boxes fetch from digi-api at runtime; every reset used to
# re-stub these as LFS pointers and the sprites silently broke until refetch)
core/rpgasset/summons/digimon/*.png -filter -diff -merge -text
# the game's OWN summon sprites (sparklinlabs idle exports, one PNG per
# registry species) must be real pixels everywhere — same deploy rule as the
# digimon cache above
core/rpgasset/summons/sparklinlabs/*.png -filter -diff -merge -text
# the abyss floor-number banner must be real pixels everywhere (reset --hard
# deploys would otherwise serve an LFS pointer to the renderer — same rule as
# ui/crystal.png above)
core/rpgasset/ui/banner_abyss.png -filter -diff -merge -text
# 2026-10-09 round 4: the regular-encounter side stages must be real pixels
# everywhere (⚠️ the abyss/*.png rule above does NOT cross into the regular/
# subdir — without this, git reset --hard deploys re-stub them as LFS pointers)
core/rpgasset/environment/abyss/regular/*.png -filter -diff -merge -text
# 2026-10-09 rounds 5-7: abyss-exclusive summon sprites must be real pixels
# everywhere (reset --hard deploys would otherwise serve LFS pointers — same
# rule as summons/sparklinlabs above)
core/rpgasset/summons/sparklinlabs_abyss/*.png -filter -diff -merge -text
