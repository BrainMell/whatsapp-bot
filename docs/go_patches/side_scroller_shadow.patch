+	// 2026-11-07 (owner: "shadows don't fit the 2.5D side-scroller style"): the old shadow was a big
+	// round radial blob (radius = 0.6 x sprite width, circular) that read as a dark halo behind the feet.
+	// A side-scroller contact shadow is a FLAT oval hugging the ground line: wide, very short, dense at
+	// the core and feathered at the rim, with a small tight core directly under the feet.
+	rx := radius * 0.78
+	ry := radius * 0.16
+	if ry < 5 {
+		ry = 5
+	}
+	dc.Push()
+	dc.Translate(x, y)
